# Local development fallback only. When no Authorization header is sent, the
# server uses this key — but only when NODE_ENV !== "production". A deployed
# server always requires the caller to bring their own key.
CODESIGNAL_API_KEY=

# CodeSignal GraphQL endpoint the tools call. Defaults to the production API.
CODESIGNAL_GRAPHQL_URL=

# OAuth (sign in with CodeSignal). Leave OAUTH_ISSUER_URL empty to accept API
# keys only; when set, OAUTH_CLIENT_ID and OAUTH_CLIENT_SECRET are required too.
#
# Issuer URL of the authorization server that signs user tokens.
OAUTH_ISSUER_URL=
# This server's client credentials at that authorization server, used to
# exchange a user's token for one the CodeSignal API accepts.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
# URL of this MCP server as users enter it in their client. Defaults to
# https://codesignal.com/api/mcp; set it for preview deployments.
MCP_RESOURCE_URL=
